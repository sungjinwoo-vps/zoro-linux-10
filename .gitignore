# ═══════════════════════════════════════════════════
# Zoro Linux 10 — .gitignore
# ═══════════════════════════════════════════════════

# Build output (compiled RPM binaries, not source specs)
/srv/
*.srpm
*.iso
*.img

# rpmbuild output directories (inside ~/rpmbuild only — NOT the source rpms/ dir.
# Note: filesystems are often case-insensitive, so do not use bare "RPMS/"
# which would also match the source "rpms/" directory.)
/rpmbuild/
/build/
/BUILDROOT/

# Temporary files
*.tmp
*.bak
*.swp
*~
/tmp/

# Logs
*.log
/var/log/antigravity/

# GPG keys (never commit keys — CI generates the public key at build time)
*.gpg
*.asc
RPM-GPG-KEY-zorolinux

# CI-generated build artifacts (rasterized from committed SVG sources)
rpms/zoro-linux-release/SOURCES/zoro-linux-logo.png
rpms/zoro-fetch/SOURCES/src/zoro-fetch
go.sum

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.code-workspace
