[zoro-baseos]
name=Zoro Linux $releasever - BaseOS
baseurl=https://mirror.zorolinux.org/$releasever/BaseOS/$basearch/os/
#mirrorlist=https://mirrors.zorolinux.org/mirrorlist?repo=baseos-$releasever&arch=$basearch
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-zorolinux
enabled=1
countme=1
metadata_expire=6h
