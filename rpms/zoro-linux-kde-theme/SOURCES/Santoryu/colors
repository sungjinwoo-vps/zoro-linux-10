# Zoro Linux Santoryu — Plasma SVG colour overrides
# Used by the Plasma theme engine to recolour SVG elements.

# Panel colours
[panel]
BackgroundColor=26,58,42,220
TextColor=245,245,240
ShadowColor=0,0,0,128
BorderColor=82,183,136,50

# Task manager
[taskbar]
